generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model UserProfile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  sentInvitations   Invitation[] @relation("Inviter")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
}

model Membership {
  id     String           @id @default(uuid()) @db.Uuid
  role   Role             @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  userId   String @db.Uuid
  tenantId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  role      Role             @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  tokenHash String           @unique

  tenantId    String @db.Uuid
  invitedById String @db.Uuid
  acceptedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy UserProfile @relation("Inviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy UserProfile? @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id            String  @id @default(uuid()) @db.Uuid
  action        String
  entity        String
  entityId      String
  actorId       String? @db.Uuid
  metadata      Json?
  tenantId      String? @db.Uuid
  requestId     String?
  correlationId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
