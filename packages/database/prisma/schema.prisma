generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model UserProfile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  sentInvitations      Invitation[]        @relation("Inviter")
  acceptedInvitations  Invitation[]        @relation("InvitationAcceptedBy")
  contentRequests      ContentRequest[]
  requestedGenerations ContentGeneration[] @relation("GenerationRequester")
  createdRevisions     ContentRevision[]   @relation("RevisionCreator")
  approvedRevisions    ContentRevision[]   @relation("RevisionApprover")
  scheduledContents    ContentSchedule[]   @relation("ScheduleCreator")
  canceledSchedules    ContentSchedule[]   @relation("ScheduleCanceler")
  socialConnections    SocialConnection[]  @relation("SocialConnectionCreator")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  timezone  String       @default("America/Sao_Paulo")

  memberships        Membership[]
  invitations        Invitation[]
  contentRequests    ContentRequest[]
  contentGenerations ContentGeneration[]
  generatedContents  GeneratedContent[]
  contentRevisions   ContentRevision[]
  contentSchedules   ContentSchedule[]
  socialConnections  SocialConnection[]
}

model Membership {
  id     String           @id @default(uuid()) @db.Uuid
  role   Role             @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  userId   String @db.Uuid
  tenantId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  email     String
  role      Role             @default(MEMBER)
  status    InvitationStatus @default(PENDING)
  tokenHash String           @unique

  tenantId     String  @db.Uuid
  invitedById  String  @db.Uuid
  acceptedById String? @db.Uuid

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy  UserProfile  @relation("Inviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy UserProfile? @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id            String  @id @default(uuid()) @db.Uuid
  action        String
  entity        String
  entityId      String
  actorId       String? @db.Uuid
  metadata      Json?
  tenantId      String? @db.Uuid
  requestId     String?
  correlationId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  GENERATING
  READY
  APPROVED
  REJECTED
  FAILED
  ARCHIVED
}

enum ContentPlatform {
  INSTAGRAM_FEED
  INSTAGRAM_STORY
  INSTAGRAM_REEL
}

enum GenerationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RevisionSource {
  AI_GENERATED
  MANUAL_EDIT
  REGENERATED
}

enum RevisionStatus {
  DRAFT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ScheduleStatus {
  SCHEDULED
  CANCELED
  DUE
  COMPLETED
  FAILED
}

model ContentRequest {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  createdById String @db.Uuid

  title     String
  briefing  String          @db.Text
  objective String?         @db.Text
  audience  String?         @db.Text
  tone      String?
  platform  ContentPlatform
  status    ContentStatus   @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy         UserProfile         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  generations       ContentGeneration[]
  generatedContents GeneratedContent[]
  revisions         ContentRevision[]
  schedules         ContentSchedule[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([createdById])
}

model ContentGeneration {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  contentRequestId String           @db.Uuid
  requestedById    String           @db.Uuid
  status           GenerationStatus @default(QUEUED)
  provider         String
  model            String
  promptVersion    String
  attempt          Int              @default(0)
  idempotencyKey   String           @unique
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contentRequest   ContentRequest    @relation(fields: [contentRequestId], references: [id], onDelete: Restrict)
  requestedBy      UserProfile       @relation("GenerationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  generatedContent GeneratedContent?

  @@index([tenantId, status])
  @@index([tenantId, contentRequestId, createdAt])
  @@index([contentRequestId, status])
}

model GeneratedContent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  contentRequestId String   @db.Uuid
  generationId     String   @unique @db.Uuid
  caption          String   @db.Text
  callToAction     String   @db.Text
  hashtags         String[]
  version          Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contentRequest ContentRequest    @relation(fields: [contentRequestId], references: [id], onDelete: Restrict)
  generation     ContentGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  revisions      ContentRevision[]

  @@unique([contentRequestId, version])
  @@index([tenantId, contentRequestId])
  @@index([tenantId, createdAt])
}

model ContentRevision {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @db.Uuid
  contentRequestId   String         @db.Uuid
  generatedContentId String?        @db.Uuid
  createdById        String         @db.Uuid
  source             RevisionSource
  caption            String         @db.Text
  callToAction       String         @db.Text
  hashtags           String[]
  version            Int
  status             RevisionStatus @default(DRAFT)
  rejectionReason    String?        @db.Text
  approvedAt         DateTime?
  approvedById       String?        @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contentRequest   ContentRequest    @relation(fields: [contentRequestId], references: [id], onDelete: Restrict)
  generatedContent GeneratedContent? @relation(fields: [generatedContentId], references: [id], onDelete: Restrict)
  createdBy        UserProfile       @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy       UserProfile?      @relation("RevisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  schedules        ContentSchedule[]

  @@unique([contentRequestId, version])
  @@index([tenantId, contentRequestId, status])
  @@index([tenantId, createdAt])
  @@index([contentRequestId, createdAt])
  @@index([generatedContentId])
  @@index([createdById])
  @@index([approvedById])
}

model ContentSchedule {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid
  contentRequestId String         @db.Uuid
  revisionId       String         @db.Uuid
  scheduledById    String         @db.Uuid
  status           ScheduleStatus @default(SCHEDULED)
  scheduledFor     DateTime       @db.Timestamptz(3)
  scheduledMinute  DateTime       @db.Timestamptz(3)
  timezone         String
  canceledAt       DateTime?
  canceledById     String?        @db.Uuid
  cancelReason     String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contentRequest ContentRequest  @relation(fields: [contentRequestId], references: [id], onDelete: Restrict)
  revision       ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  scheduledBy    UserProfile     @relation("ScheduleCreator", fields: [scheduledById], references: [id], onDelete: Restrict)
  canceledBy     UserProfile?    @relation("ScheduleCanceler", fields: [canceledById], references: [id], onDelete: SetNull)

  @@index([tenantId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
  @@index([contentRequestId, status])
  @@index([revisionId])
  @@index([scheduledById])
  @@index([canceledById])
}

enum SocialProvider {
  META_INSTAGRAM
}

enum SocialConnectionErrorCategory {
  TRANSIENT_ERROR
  RATE_LIMITED
  EXPIRED
  REVOKED
  PERMISSION_ERROR
  INVALID_RESPONSE
}

enum SocialConnectionStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
  DISCONNECTED
}

model OAuthState {
  stateHash  String         @id
  tenantId   String         @db.Uuid
  userId     String         @db.Uuid
  provider   SocialProvider
  returnPath String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@map("oauth_states")
}

model OAuthSession {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @db.Uuid
  userId               String         @db.Uuid
  provider             SocialProvider
  accessTokenEncrypted String
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@map("oauth_sessions")
}

model SocialConnection {
  id                    String                         @id @default(uuid()) @db.Uuid
  tenantId              String                         @db.Uuid
  provider              SocialProvider
  status                SocialConnectionStatus         @default(PENDING)
  externalAccountId     String?
  externalAccountName   String?
  pageId                String?
  instagramAccountId    String?
  scopes                String[]
  accessTokenEncrypted  String?
  tokenExpiresAt        DateTime?
  refreshMetadata       Json?
  connectedById         String                         @db.Uuid
  connectedAt           DateTime?                      @default(now())
  disconnectedAt        DateTime?
  lastValidatedAt       DateTime?
  lastErrorCode         String?
  lastRefreshAttemptAt  DateTime?
  lastRefreshSuccessAt  DateTime?
  nextRefreshAt         DateTime?
  refreshFailureCount   Int                            @default(0)
  processingLockedUntil DateTime?
  lastErrorAt           DateTime?
  lastErrorCategory     SocialConnectionErrorCategory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connectedBy UserProfile @relation("SocialConnectionCreator", fields: [connectedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider])
  @@map("social_connections")
}
