# ==========================================
# ENV TEMPLATE - HOMOLOGAÇÃO (STAGING)
# ==========================================

# ------------------------------------------
# APLICAÇÃO (GLOBAL)
# ------------------------------------------
NODE_ENV=production
APP_ENV=staging
PORT=3000

# ------------------------------------------
# URLs E TRAEFIK
# ------------------------------------------
WEB_PUBLIC_URL=https://app-staging.dominio.com
API_PUBLIC_URL=https://api-staging.dominio.com
NEXT_PUBLIC_API_URL=https://api-staging.dominio.com
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERTRESOLVER=production
STAGING_WEB_HOST=app-staging.dominio.com
STAGING_API_HOST=api-staging.dominio.com

# ------------------------------------------
# BANCO DE DADOS (SUPABASE)
# ------------------------------------------
SUPABASE_URL=https://[YOUR_STAGING_SUPABASE_ID].supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_JWT_SECRET=your-staging-jwt-secret

DATABASE_URL=postgres://[user]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgres://[user]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ------------------------------------------
# REDIS
# ------------------------------------------
REDIS_URL=redis://social-media-gads-redis-staging:6379/0

# ------------------------------------------
# SEGURANÇA E COOKIES
# ------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY_V1=replace-with-a-32-byte-aes-256-gcm-key
CORS_ORIGINS=https://app-staging.dominio.com
COOKIE_DOMAIN=.dominio.com
COOKIE_SECURE=true

# ------------------------------------------
# INTEGRAÇÕES (META/INSTAGRAM)
# ------------------------------------------
META_APP_ID=your_staging_meta_app_id
META_APP_SECRET=your_staging_meta_app_secret
META_REDIRECT_URI=https://api-staging.dominio.com/api/integrations/meta/callback
# Graph API Version deve vir da configuração já validada, deixar vazio ou preencher no deploy.
META_GRAPH_API_VERSION=
META_TOKEN_REFRESH_MARGIN_DAYS=14
